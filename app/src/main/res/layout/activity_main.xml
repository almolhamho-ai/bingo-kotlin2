<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ========== شاشة 1: الافتتاحية ========== -->
    <LinearLayout
        android:id="@+id/screenLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/letterRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="40dp">

            <TextView android:id="@+id/letterB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
            <TextView android:id="@+id/letterI" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
            <TextView android:id="@+id/letterN" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
            <TextView android:id="@+id/letterG" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
            <TextView android:id="@+id/letterO" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="O" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
        </LinearLayout>

        <Button
            android:id="@+id/startTapBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_button_gold"
            android:textColor="@color/dark_text_on_gold"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="invisible"
            android:text="اضغط للبدء" />
    </LinearLayout>

    <!-- ========== شاشة 2: القائمة الرئيسية ========== -->
    <LinearLayout
        android:id="@+id/screenWelcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <Button
            android:id="@+id/settingsIconBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:textColor="@color/gold"
            android:text="⚙ الإعدادات" />

        <TextView
            android:id="@+id/welcomeGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:text="أهلاً" />

        <Button android:id="@+id/cardNetwork" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card_network" android:textColor="#FFFFFF" android:textStyle="bold"
            android:padding="16dp" android:layout_marginBottom="10dp"
            android:text="🌐 لعب شبكي" />

        <Button android:id="@+id/cardAI" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card_ai" android:textColor="#FFFFFF" android:textStyle="bold"
            android:padding="16dp" android:layout_marginBottom="10dp"
            android:text="🤖 ضد الذكاء الاصطناعي (قريباً)" />

        <Button android:id="@+id/cardFriends" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card_friends" android:textColor="#FFFFFF" android:textStyle="bold"
            android:padding="16dp" android:layout_marginBottom="10dp"
            android:text="👥 أصدقاء (قريباً)" />

        <Button android:id="@+id/cardLevels" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card_levels" android:textColor="#FFFFFF" android:textStyle="bold"
            android:padding="16dp" android:layout_marginBottom="10dp"
            android:text="🏆 مستويات (قريباً)" />

        <Button android:id="@+id/cardDaily" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card_daily" android:textColor="#FFFFFF" android:textStyle="bold"
            android:padding="16dp" android:layout_marginBottom="10dp"
            android:text="📅 تحدي يومي (قريباً)" />

        <Button android:id="@+id/cardTournament" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card_tournament" android:textColor="#FFFFFF" android:textStyle="bold"
            android:padding="16dp"
            android:text="🏅 بطولة (قريباً)" />
    </LinearLayout>

    <!-- ========== شاشة 3: الإعدادات ========== -->
    <LinearLayout
        android:id="@+id/screenSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <Button
            android:id="@+id/backFromSettingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="@color/muted"
            android:text="→ رجوع" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:layout_marginTop="16dp" android:text="الاسم" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_main"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:layout_marginBottom="10dp" android:text="اللون" />

        <GridLayout
            android:id="@+id/themeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/saveSettingsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_gold"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/dark_text_on_gold"
            android:textStyle="bold"
            android:padding="14dp"
            android:text="حفظ" />
    </LinearLayout>

    <!-- ========== شاشة 4: الشبكة (استضافة/انضمام) ========== -->
    <LinearLayout
        android:id="@+id/screenNetwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <Button
            android:id="@+id/backFromNetworkBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:background="@android:color/transparent"
            android:textColor="@color/muted"
            android:layout_marginBottom="16dp"
            android:text="→ رجوع" />

        <TextView
            android:id="@+id/networkStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:text="اختر: استضافة أو انضمام" />

        <EditText
            android:id="@+id/ipInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="عنوان IP المضيف (للانضمام فقط)"
            android:textColorHint="@color/muted"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hostBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_button_gold"
                android:textColor="@color/dark_text_on_gold"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="استضافة (Host)" />

            <Button
                android:id="@+id/joinBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_gold"
                android:textColor="@color/dark_text_on_gold"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="انضمام (Join)" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== شاشة 5: اللعب ========== -->
    <LinearLayout
        android:id="@+id/screenGame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:text="" />

        <GridLayout
            android:id="@+id/gameGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="5" />
    </LinearLayout>

    <!-- ========== شاشة 6: الفوز ========== -->
    <LinearLayout
        android:id="@+id/screenWin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/winBadge"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:gravity="center"
            android:background="@drawable/bg_win_badge"
            android:text="🏆"
            android:textSize="46sp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/winTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"
            android:text="!BINGO" />

        <TextView
            android:id="@+id/winSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"
            android:text="" />

        <Button
            android:id="@+id/playAgainBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_button_gold"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/dark_text_on_gold"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:text="لعبة جديدة" />

        <Button
            android:id="@+id/winHomeBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="@color/muted"
            android:text="القائمة الرئيسية" />
    </LinearLayout>

    <!-- ========== شاشة 7: إعدادات اللعب ضد الذكاء الاصطناعي ========== -->
    <ScrollView
        android:id="@+id/screenAiSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/backFromAiSetupBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="@color/muted"
                android:layout_marginBottom="10dp"
                android:text="→ رجوع" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"
                android:text="إعدادات اللعب ضد الذكاء الاصطناعي" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:layout_marginBottom="6dp"
                android:text="عدد خصوم الذكاء الاصطناعي" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/aiCountMinusBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/text_main"
                    android:text="−" />

                <TextView
                    android:id="@+id/aiCountText"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="1" />

                <Button
                    android:id="@+id/aiCountPlusBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/text_main"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/aiNamesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:layout_marginBottom="6dp"
                android:text="مستوى الصعوبة" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button android:id="@+id/diffEasyBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_input" android:textColor="@color/text_main" android:textSize="12sp" android:text="سهل" />
                <Button android:id="@+id/diffMediumBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_input" android:textColor="@color/text_main" android:textSize="12sp" android:text="متوسط" />
                <Button android:id="@+id/diffHardBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_input" android:textColor="@color/text_main" android:textSize="12sp" android:text="صعب" />
                <Button android:id="@+id/diffExpertBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_input" android:textColor="@color/text_main" android:textSize="12sp" android:text="خبير" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:layout_marginBottom="6dp"
                android:text="سرعة الذكاء الاصطناعي" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button android:id="@+id/speedSlowBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_input" android:textColor="@color/text_main" android:textSize="12sp" android:text="🐢 بطيء" />
                <Button android:id="@+id/speedMediumBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_input" android:textColor="@color/text_main" android:textSize="12sp" android:text="🚶 وسط" />
                <Button android:id="@+id/speedFastBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_input" android:textColor="@color/text_main" android:textSize="12sp" android:text="⚡ سريع" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:layout_marginBottom="6dp"
                android:text="ترتيب شبكتك" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/arrangeManualBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/text_main"
                    android:textSize="12sp"
                    android:text="✋ ترتيب يدوي" />

                <Button
                    android:id="@+id/arrangeRandomBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/text_main"
                    android:textSize="12sp"
                    android:text="🔀 ترتيب عشوائي" />
            </LinearLayout>

            <TextView
                android:id="@+id/arrangeStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:layout_marginBottom="20dp"
                android:text="⚠️ لسا لازم ترتب شبكتك (يدوي أو عشوائي)" />

            <Button
                android:id="@+id/startAiSetupBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_gold"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/dark_text_on_gold"
                android:textStyle="bold"
                android:padding="14dp"
                android:text="ابدأ اللعبة 🎱" />
        </LinearLayout>
    </ScrollView>

    <!-- ========== شاشة 8: ترتيب الشبكة يدوياً ========== -->
    <LinearLayout
        android:id="@+id/screenArrange"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <Button
            android:id="@+id/backFromArrangeBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:background="@android:color/transparent"
            android:textColor="@color/muted"
            android:layout_marginBottom="10dp"
            android:text="→ رجوع" />

        <TextView
            android:id="@+id/arrangeTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="14dp"
            android:text="اضغط على الأرقام بالترتيب اللي بدك ياه لملء شبكتك" />

        <GridLayout
            android:id="@+id/arrangeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="5" />
    </LinearLayout>

</FrameLayout>
