<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ========== شاشة 1: الافتتاحية ========== -->
    <LinearLayout
        android:id="@+id/screenLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/letterRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="40dp">

            <TextView android:id="@+id/letterB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
            <TextView android:id="@+id/letterI" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
            <TextView android:id="@+id/letterN" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
            <TextView android:id="@+id/letterG" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
            <TextView android:id="@+id/letterO" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="O" android:textSize="52sp" android:textStyle="bold" android:textColor="@color/gold" />
        </LinearLayout>

        <Button
            android:id="@+id/startTapBtn"
            android:elevation="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_button_gold"
            android:textColor="@color/dark_text_on_gold"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="invisible"
            android:text="اضغط للبدء" />
    </LinearLayout>

    <!-- ========== شاشة 2: القائمة الرئيسية ========== -->
    <LinearLayout
        android:id="@+id/screenWelcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <Button
            android:id="@+id/settingsIconBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:textColor="@color/gold"
            android:text="⚙ الإعدادات" />

        <TextView
            android:id="@+id/welcomeGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:text="أهلاً" />

        <LinearLayout
            android:id="@+id/cardAI"
            android:elevation="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_ai"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="14dp"
                android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="📱" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العب ضد الهاتف" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تحدَّ الذكاء الاصطناعي" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardFriends"
            android:elevation="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_friends"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="14dp"
                android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="👥" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اللعب مع الأصدقاء" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تمرير الهاتف بينكم (قريباً)" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardNetwork"
            android:elevation="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_network"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="14dp"
                android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="📶" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اللعب الشبكي" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عدة أجهزة عبر نقطة اتصال، بدون إنترنت" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardDaily"
            android:elevation="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_daily"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="14dp"
                android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="🗓️" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="التحدي اليومي" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تحدٍ جديد كل يوم (قريباً)" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardTournament"
            android:elevation="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_tournament"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="14dp"
                android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="🏆" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بطولة الأصدقاء" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 أو 8 لاعبين، إقصاء مباشر (قريباً)" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardLevels"
            android:elevation="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_levels"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="14dp"
                android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="🎯" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المستويات" android:textColor="#1A1000" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100 مستوى مليء بالتحدي (قريباً)" android:textColor="#661A1000" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========== شاشة 3: الإعدادات ========== -->
    <LinearLayout
        android:id="@+id/screenSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <Button
            android:id="@+id/backFromSettingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="@color/muted"
            android:text="→ رجوع" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:layout_marginTop="16dp" android:text="الاسم" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_main"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:layout_marginBottom="10dp" android:text="اللون" />

        <GridLayout
            android:id="@+id/themeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/saveSettingsBtn"
            android:elevation="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_gold"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/dark_text_on_gold"
            android:textStyle="bold"
            android:padding="14dp"
            android:text="حفظ" />
    </LinearLayout>

    <!-- ========== شاشة 4: الشبكة (استضافة/انضمام) ========== -->
    <LinearLayout
        android:id="@+id/screenNetwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <Button
            android:id="@+id/backFromNetworkBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:background="@android:color/transparent"
            android:textColor="@color/muted"
            android:layout_marginBottom="16dp"
            android:text="→ رجوع" />

        <TextView
            android:id="@+id/networkStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:text="اختر: استضافة أو انضمام" />

        <EditText
            android:id="@+id/ipInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="عنوان IP المضيف (للانضمام فقط)"
            android:textColorHint="@color/muted"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hostBtn"
            android:elevation="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_button_gold"
                android:textColor="@color/dark_text_on_gold"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="استضافة (Host)" />

            <Button
                android:id="@+id/joinBtn"
            android:elevation="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_gold"
                android:textColor="@color/dark_text_on_gold"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="انضمام (Join)" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== شاشة 5: اللعب ========== -->
    <LinearLayout
        android:id="@+id/screenGame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:text="" />

        <GridLayout
            android:id="@+id/gameGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="5" />
    </LinearLayout>

    <!-- ========== شاشة 6: الفوز ========== -->
    <LinearLayout
        android:id="@+id/screenWin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/winBadge"
            android:elevation="14dp"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:gravity="center"
            android:background="@drawable/bg_win_badge"
            android:text="🏆"
            android:textSize="46sp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/winTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"
            android:text="!BINGO" />

        <TextView
            android:id="@+id/winSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"
            android:text="" />

        <Button
            android:id="@+id/playAgainBtn"
            android:elevation="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_button_gold"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/dark_text_on_gold"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:text="لعبة جديدة" />

        <Button
            android:id="@+id/winHomeBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="@color/muted"
            android:text="القائمة الرئيسية" />
    </LinearLayout>

    <!-- ========== شاشة 7: إعدادات اللعب ضد الذكاء الاصطناعي ========== -->
    <ScrollView
        android:id="@+id/screenAiSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/backFromAiSetupBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="@color/muted"
                android:layout_marginBottom="10dp"
                android:text="→ رجوع" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"
                android:text="إعدادات اللعب ضد الذكاء الاصطناعي" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_panel"
                android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:layout_marginBottom="6dp"
                android:text="عدد لاعبي الهاتف (ذكاء اصطناعي)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button android:id="@+id/aiCount1Btn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" android:text="1" />
                <Button android:id="@+id/aiCount2Btn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" android:text="2" />
                <Button android:id="@+id/aiCount3Btn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" android:text="3" />
                <Button android:id="@+id/aiCount4Btn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" android:text="4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/aiNamesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:layout_marginBottom="6dp"
                android:text="مستوى الصعوبة" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button android:id="@+id/diffEasyBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="12sp" android:text="سهل" />
                <Button android:id="@+id/diffMediumBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="12sp" android:text="متوسط" />
                <Button android:id="@+id/diffHardBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="12sp" android:text="صعب" />
                <Button android:id="@+id/diffExpertBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="12sp" android:text="خبير" />
            </LinearLayout>

            <Button
                android:id="@+id/startAiSetupBtn"
                android:elevation="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_gold"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/dark_text_on_gold"
                android:textStyle="bold"
                android:padding="14dp"
                android:text="ابدأ اللعبة 🎱" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ========== شاشة 8: ترتيب الشبكة يدوياً ========== -->
    <ScrollView
        android:id="@+id/screenArrange"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/backFromArrangeBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:background="@android:color/transparent"
                android:textColor="@color/muted"
                android:layout_marginBottom="10dp"
                android:text="→ رجوع" />

            <TextView
                android:id="@+id/arrangeTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="4dp"
                android:text="رتّب شبكتك" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="14dp"
                android:text="اضغط على الأرقام بالترتيب اللي بدك ياه — بتظهر مباشرة بشبكتك تحت. اضغط على أي خانة بالشبكة لإلغاء آخر شي حطيته فيها" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"
                android:text="الأرقام المتاحة" />

            <GridLayout
                android:id="@+id/numberPool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:rowCount="5"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"
                android:text="شبكتك" />

            <GridLayout
                android:id="@+id/arrangePreviewGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:rowCount="5"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/arrRandomBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_panel"
                    android:textColor="@color/muted"
                    android:padding="12dp"
                    android:text="🔀" />

                <Button
                    android:id="@+id/arrConfirmBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/muted"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:enabled="false"
                    android:text="ابدأ اللعبة 🎱" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ========== شاشة: إعدادات اللعب المحلي بين أصدقاء ========== -->
    <ScrollView
        android:id="@+id/screenFriendsSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/backFromFriendsSetupBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="@color/muted"
                android:layout_marginBottom="10dp"
                android:text="→ رجوع" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"
                android:text="لعب محلي بين أصدقاء (تمرير الجهاز)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:layout_marginBottom="6dp"
                android:text="عدد اللاعبين" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button android:id="@+id/friendsCount2Btn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" android:text="2" />
                <Button android:id="@+id/friendsCount3Btn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" android:text="3" />
                <Button android:id="@+id/friendsCount4Btn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" android:text="4" />
                <Button android:id="@+id/friendsCount5Btn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_choice" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" android:text="5" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/friendsNamesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:layout_marginBottom="18dp"
                android:text="كل لاعب برتّب شبكته الخاصة بدوره بعد الضغط على ابدأ" />

            <Button
                android:id="@+id/startFriendsSetupBtn"
                android:elevation="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_gold"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/dark_text_on_gold"
                android:textStyle="bold"
                android:padding="14dp"
                android:text="ابدأ اللعبة 🎱" />
        </LinearLayout>
    </ScrollView>

    <!-- ========== شاشة: تمرير الجهاز بين اللاعبين ========== -->
    <LinearLayout
        android:id="@+id/screenPassDevice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱"
            android:textSize="52sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/passDeviceNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginBottom="36dp"
            android:text="مرر الجهاز إلى:" />

        <Button
            android:id="@+id/passDeviceReadyBtn"
            android:elevation="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_button_gold"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/dark_text_on_gold"
            android:textStyle="bold"
            android:text="أنا جاهز ✅" />
    </LinearLayout>

</FrameLayout>
